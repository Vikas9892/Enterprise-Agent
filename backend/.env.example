# ==============================================================================
# Enterprise Agent - Environment Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Application Settings
APP_NAME="Enterprise Agent Platform"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration (Phase 2 Active)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Security & Authentication (Phase 3 Active)
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Future Phase Placeholders (Not active yet)
# ==============================================================================
# REDIS_URL=redis://localhost:6379/0
# LITELLM_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=enterprise-agent
# MCP_SERVER_URL=http://localhost:8001

# ==============================================================================
# Enterprise Agent Monorepo - Environment Configuration (.env.example)
# Copy this file to .env or backend/.env and adjust values as needed.
# ==============================================================================

# Backend Service
BACKEND_PORT=8000
APP_NAME="Enterprise Agent Platform"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_agent

# Frontend Service (Next.js - Upcoming Phase)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# MCP Server Service (Upcoming Phase)
MCP_SERVER_PORT=8001
